{
  "name": "nareulbom-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:server": "node --test server/*.test.mjs",
    "export:web": "expo export --platform web",
    "check:api": "node --env-file-if-exists=.env scripts/check-api.mjs",
    "test:storage": "node --experimental-strip-types --test src/data/*.test.mjs",
    "check:permit": "node --env-file-if-exists=.env scripts/check-permit.mjs",
    "auth:migrate": "node --env-file-if-exists=.env server/migrate.mjs",
    "auth:plan": "node --env-file-if-exists=.env server/migrate.mjs --plan",
    "auth:db": "node server/dev-db.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.14",
    "better-auth": "^1.7.14",
    "expo": "~57.0.30",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.13",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
