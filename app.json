{
  "expo": {
    "name": "나를봄",
    "slug": "nareulbom-mobile",
    "version": "0.1.0",
    "scheme": "nareulbom",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.co.uulab.nareulbom"
    },
    "android": {
      "package": "kr.co.uulab.nareulbom",
      "icon": "./assets/images/app-icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "icon": "./assets/images/app-icon.png"
  }
}
