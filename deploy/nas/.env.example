# NAS에서 이 폴더의 .env로 복사하고 값을 직접 설정하세요. 커밋 금지.
# 외부 접근 가능한 실제 DNS 이름만 입력 (https:// 및 경로 제외)
AUTH_DOMAIN=
# openssl rand -hex 32 로 각각 다른 비밀번호 생성 (URL 안전한 hex 사용)
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
# openssl rand -base64 48 (서버 토큰 암호화용, 비밀번호와 다른 값)
BETTER_AUTH_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
MFDS_SERVICE_KEY=
MFDS_PERMIT_SERVICE_KEY=
CORS_ORIGIN=http://localhost:8081
# Apple 연결 시 .p8 파일을 API 컨테이너에 읽기 전용 마운트한 후 경로 지정
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
