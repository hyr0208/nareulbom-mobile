# Android 에뮬레이터: http://10.0.2.2:8788 / 실기기: 개발 컴퓨터의 LAN 주소
EXPO_PUBLIC_API_URL=http://localhost:8788
# 공공데이터포털 e약은요 활용 신청 후 발급받은 Decoding 인증키. 서버에서만 사용.
MFDS_SERVICE_KEY=
PORT=8788
# 웹 개발 서버 주소. 운영에서는 허용 출처를 명시.
CORS_ORIGIN=http://localhost:8081

# 의약품 제품 허가정보(15095677) 추가 활용 신청 후 별도 키 사용 시 설정. 비어 있으면 MFDS_SERVICE_KEY 사용.
MFDS_PERMIT_SERVICE_KEY=

# 로그인 서버. 건강정보/복용 기록 동기화는 아직 하지 않습니다.
# openssl rand -base64 48 로 만든 값을 서버 전용으로 설정 (최소 32자).
BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://localhost:8788
# PostgreSQL 연결 문자열. 운영은 TLS와 인증서 검증을 사용하세요.
DATABASE_URL=
# 나를봄 전용 카카오 앱 → 앱 → 플랫폼 키 → REST API 키
# 리다이렉트 URI: http://localhost:8788/api/auth/callback/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Apple Developer: Service ID / Team ID / Key ID / 서버에만 보관하는 .p8 경로
# Apple은 실제 HTTPS 도메인과 /api/auth/callback/apple Return URL 설정이 필요합니다.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
